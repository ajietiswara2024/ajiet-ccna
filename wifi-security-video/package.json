{
  "name": "wifi-gratis-aman-nggak",
  "version": "1.0.0",
  "description": "Video edukasi keamanan Wi-Fi publik (Remotion + React Three Fiber)",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
