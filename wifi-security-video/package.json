    "@remotion/three": "^4.0.543",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.543",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3"
  }
